{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novel2script.local/schema.json",
  "title": "Novel2Script Script Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metadata",
    "chapters",
    "characters",
    "locations",
    "events",
    "scenes",
    "adaptation_notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "title",
        "source_type",
        "language",
        "adaptation_type",
        "generated_at"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "adaptation_type": {
          "type": "string"
        },
        "generated_at": {
          "type": "string"
        }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/chapter"
      }
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/character"
      }
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/location"
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "adaptation_notes": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "retained",
        "changed",
        "next_steps"
      ],
      "properties": {
        "retained": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "chapter": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "title",
        "order",
        "word_count"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "word_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "name",
        "aliases",
        "role",
        "description",
        "goal"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "role": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "name",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "source_chapter",
        "summary",
        "conflict",
        "emotional_shift",
        "characters"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_chapter": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "conflict": {
          "type": "string"
        },
        "emotional_shift": {
          "type": "string"
        },
        "characters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "source_chapters",
        "heading",
        "purpose",
        "conflict",
        "characters",
        "elements"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_chapters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "heading": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "location_id",
            "time_of_day"
          ],
          "properties": {
            "location_id": {
              "type": "string",
              "minLength": 1
            },
            "time_of_day": {
              "type": "string"
            }
          }
        },
        "purpose": {
          "type": "string"
        },
        "conflict": {
          "type": "string"
        },
        "characters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "elements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/scene_element"
          }
        }
      }
    },
    "scene_element": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "action",
            "dialogue",
            "narration",
            "transition",
            "sound",
            "shot"
          ]
        },
        "text": {
          "type": "string"
        },
        "character_id": {
          "type": "string"
        },
        "event_id": {
          "type": "string"
        }
      }
    }
  }
}
